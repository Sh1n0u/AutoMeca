<Window x:Class="AutoMeca.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoMeca"
        Title="AutoMeca - Maintenance Industrielle" Height="500" Width="800"
        WindowStartupLocation="CenterScreen" Background="#F4F6F9">
		
	<Grid Margin="30,20,30,15">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<Grid Grid.Row="0">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<!-- Title -->
			<TextBlock Grid.Row="0" Text="AutoMeca" FontSize="28" FontWeight="Bold" 
						Foreground="#2C3E50" HorizontalAlignment="Center"/>
			<TextBlock Grid.Row="1" Text="Sélectionnez un module pour continuer" FontSize="14" 
						Foreground="#7F8C8D" HorizontalAlignment="Center" Margin="0,5,0,30"/>

			<!-- Button Grid -->
			<UniformGrid Grid.Row="2" Rows="2" Columns="2">

				<!-- Maintenance Button -->
				<Button Margin="10" Click="BtnMaintenance_Click" Background="White" BorderBrush="#BDC3C7" BorderThickness="1">
					<StackPanel VerticalAlignment="Center">
						<TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="32" HorizontalAlignment="Center"/>
						<TextBlock Text="Maintenance" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
						<TextBlock Text="Ordre de travail &amp; pannes" FontSize="11"  Foreground="#7F8C8D" HorizontalAlignment="Center"/>
					</StackPanel>
				</Button>

				<!-- Stock Button -->
				<Button Margin="10" Click="BtnStock_Click" Background="White" BorderBrush="#BDC3C7" BorderThickness="1">
					<StackPanel VerticalAlignment="Center">
						<TextBlock Text="&#xF133;" FontFamily="Segoe MDL2 Assets" FontSize="32" HorizontalAlignment="Center"/>
						<TextBlock Text="Stock" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
						<TextBlock Text="Pièces détachées" FontSize="11"  Foreground="#7F8C8D" HorizontalAlignment="Center"/>
					</StackPanel>
				</Button>

				<!-- Machine Button -->
				<Button Margin="10" Click="BtnMachine_Click" Background="White" BorderBrush="#BDC3C7" BorderThickness="1">
					<StackPanel VerticalAlignment="Center">
						<TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="32" HorizontalAlignment="Center"/>
						<TextBlock Text="Stock" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
						<TextBlock Text="Liste des machines" FontSize="11"  Foreground="#7F8C8D" HorizontalAlignment="Center"/>
					</StackPanel>
				</Button>

				<!-- Fournisseurs Button -->
				<Button Margin="10" Click="BtnFournisseurs_Click" Background="White" BorderBrush="#BDC3C7" BorderThickness="1">
					<StackPanel VerticalAlignment="Center">
						<TextBlock Text="&#xEB4D;" FontFamily="Segoe MDL2 Assets" FontSize="32" HorizontalAlignment="Center"/>
						<TextBlock Text="Fournisseurs" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
						<TextBlock Text="Liste des fournisseurs" FontSize="11"  Foreground="#7F8C8D" HorizontalAlignment="Center"/>
					</StackPanel>
				</Button> 
			</UniformGrid>
		</Grid>

		<!-- Footer -->
		<TextBlock Grid.Row="3" Text=" Créé par Florian SUNE - AutoMeca v1.0" FontSize="11" Foreground="#95A5A6" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,0"/>
    </Grid>
</Window>
